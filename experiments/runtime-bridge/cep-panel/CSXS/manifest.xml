<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  CEP 12 manifest for ae-devtools-bridge.

  Status: UNVERIFIED. This manifest follows the official CEP 5.0+ /
  CEP 12 shape (Adobe-CEP CEP_HTML_Test_Extension-12.0 sample +
  ExtensionManifest_v_7_0.xsd, unchanged through CEP 12). It has not
  been loaded by a real After Effects instance in the environment that
  produced this repository. See ../EXPERIMENT-LOG.md Probe 01 and
  docs/architecture/research/07-real-ae-validation.md.

  Key fields:
    ExtensionBundleId    : namespace/name; must match the install folder name.
    Extension Id         : the slot AE looks up under Window > Extensions.
    RequiredRuntimeList  : CEP 12.x (per research/corrections-02:
                            AE 25.0 → CEP 12 is Cookbook-confirmed).
    HostList             : After Effects (AEFT). Single-host v1.
    MainPath             : the panel's HTML shell.

  AE 25.0 → CEP 12 is Cookbook-confirmed (CEP 12 HTML Extension
  Cookbook, FY2024 column, AEFT 25.0). AE 24.x → CEP version is NOT
  Cookbook-confirmed; the most plausible reading is AE 24.x → CEP 11
  (community-attributed, elevenpercent.net AutoEdit docs). See
  research/corrections-02 for the per-version verdicts.

  Do NOT reintroduce the pre-CEP5 shape (HostList/RequiredRuntimeList
  as attributes inside Extension/DispatchInfo): it does not validate
  against the official XSD. Same defect class fixed in PR #40 for
  experiments/cep-extension/.
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="ae-devtools-bridge"
                   ExtensionBundleVersion="0.1.0"
                   Version="12.0">

  <ExtensionList>
    <Extension Id="ae-devtools-bridge-panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects host; Version is an XSD RangedVersion -->
      <Host Name="AEFT" Version="[25.0,99.0]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="ae-devtools-bridge-panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!--
            ScriptPath is intentionally omitted for v1 of this panel:
            the panel's ExtendScript bridge is invoked exclusively via
            CSInterface.evalScript from JS, not via a separate
            ExtendScript startup script. See
            ../EXPERIMENT-LOG.md Probe 01 and
            docs/architecture/ADR-0001-runtime-bridge.md Decision 2
            ("all CSInterface.evalScript calls funnel through one
            chokepoint module").
          -->
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>ae-devtools bridge</Menu>
          <Geometry>
            <Size>
              <Height>480</Height>
              <Width>640</Width>
            </Size>
            <MinSize>
              <Height>240</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
