<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  CEP manifest generated by experiments/cep-extension/scaffold.mjs
  (Issue #36, CAP057). Status: scaffold output — NOT yet loaded by a
  real After Effects. See ../LOAD-PROOF.md and ../EVIDENCE.md.

  Structure follows the official CEP 5.0+ / CEP 12 manifest shape
  (Adobe-CEP CEP_HTML_Test_Extension-12.0 sample + ExtensionManifest_v_7_0.xsd,
  unchanged through CEP 12):

    ExtensionManifest
      ExtensionList            -> extension ids + versions
      ExecutionEnvironment     -> HostList (AEFT), LocaleList, RequiredRuntimeList (CSXS)
      DispatchInfoList         -> per-extension DispatchInfo
        Resources/MainPath, Lifecycle/AutoVisible, UI/Type=Panel

  Do NOT reintroduce the pre-CEP5 shape (HostList/RequiredRuntimeList as
  attributes inside Extension/DispatchInfo): it does not validate against
  the official XSD. tests/scaffold.test.mjs XSD-validates this output.
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="{{EXT_ID}}"
                   ExtensionBundleVersion="{{EXT_VERSION}}"
                   Version="{{CSXS_VERSION}}">

  <ExtensionList>
    <Extension Id="{{EXT_ID}}" Version="{{EXT_VERSION}}"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects host; Version is an XSD RangedVersion -->
      <Host Name="AEFT" Version="{{HOST_RANGE}}"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="{{CSXS_VERSION}}"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="{{EXT_ID}}">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>{{EXT_TITLE}}</Menu>
          <Geometry>
            <Size>
              <Height>480</Height>
              <Width>640</Width>
            </Size>
            <MinSize>
              <Height>240</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
