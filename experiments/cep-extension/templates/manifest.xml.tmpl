<?xml version="1.0" encoding="UTF-8"?>
<!--
  CEP manifest generated by experiments/cep-extension/scaffold.mjs
  (Issue #36, CAP057). Status: scaffold output — NOT yet loaded by a
  real After Effects. See ../LOAD-PROOF.md and ../EVIDENCE.md.

  Fields:
    Extension Id            : {{EXT_ID}} — must match intent; CEP looks the
                              panel up under Window > Extensions by host.
    RequiredRuntimeList     : CSXS-{{CSXS_VERSION}}.
    HostList                : After Effects (AEFT), Version {{HOST_RANGE}}.
    MainPath                : ./index.html.

  CSInterface.js is referenced by index.html as a host-provided script;
  whether AE/CEP actually provides it at runtime is itself a load-proof
  verification item (see LOAD-PROOF.md §4).
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:noNamespaceSchemaLocation="../../CEP-Resources/schema/manifest_schema.xsd"
                  Version="{{CSXS_VERSION}}">

  <ExtensionList>
    <Extension Id="{{EXT_ID}}"
               Version="{{EXT_VERSION}}"
               RequiredRuntimeList="CSXS-{{CSXS_VERSION}}">
      <DispatchInfoList>
        <DispatchInfo>
          <HostList>
            <!-- After Effects host -->
            <Host Name="AEFT" Version="{{HOST_RANGE}}" />
          </HostList>
          <Resources>
            <MainPath>./index.html</MainPath>
          </Resources>
          <Lifecycle>
            <AutoVisible>true</AutoVisible>
          </Lifecycle>
        </DispatchInfo>
      </DispatchInfoList>
    </Extension>
  </ExtensionList>

</ExtensionManifest>
