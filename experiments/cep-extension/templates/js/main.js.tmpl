/*
 * main.js — scaffold panel wiring (generated by scaffold.mjs).
 *
 * Status: scaffold output. ES5, zero dependencies. Every result and
 * error is written to #result AND console.log'd so panel logs can feed
 * the future unified diagnostics surface (Issue #37).
 *
 * The "intentional error probe" runs ExtendScript that throws, so the
 * evalScript error path can be observed end-to-end during load proof.
 */
(function () {
  "use strict";

  var EXT_ID = "{{EXT_ID:js}}";
  var EXT_VERSION = "{{EXT_VERSION:js}}";

  function log(level, obj) {
    var line = "[" + EXT_ID + "@" + EXT_VERSION + "] " + level + " " +
      (typeof obj === "string" ? obj : JSON.stringify(obj));
    // Panel log — CEP routes console.* to the host log / JS console.
    if (level === "error") { console.error(line); } else { console.log(line); }
  }

  function setResult(label, err, value) {
    var el = document.getElementById("result");
    el.textContent = JSON.stringify({ probe: label, err: err || null, value: value === undefined ? null : value }, null, 2);
    log(err ? "error" : "info", { probe: label, err: err, value: value });
  }

  function runScript(label, source) {
    if (!window.csWrap) {
      setResult(label, { kind: "no_csinterface", detail: "CSInterface.js not loaded" }, null);
      return;
    }
    csWrap.evalScript(source, function (err, raw) {
      // evalScript callbacks receive a string; try JSON for structure.
      var value = raw;
      if (typeof raw === "string" && raw.length > 0) {
        try { value = JSON.parse(raw); } catch (e) { /* keep raw string */ }
      }
      setResult(label, err, value);
    });
  }

  function wire() {
    var apiBtn = document.getElementById("btn-api-version");
    if (apiBtn) {
      apiBtn.addEventListener("click", function () {
        if (!window.csWrap) {
          document.getElementById("api-version").textContent = JSON.stringify({ error: "no_csinterface" });
          return;
        }
        document.getElementById("api-version").textContent = JSON.stringify(csWrap.getCurrentApiVersion());
      });
    }
    var vBtn = document.getElementById("btn-ae-version");
    if (vBtn) {
      vBtn.addEventListener("click", function () {
        runScript("app.version", "app.version()");
      });
    }
    var eBtn = document.getElementById("btn-ae-error");
    if (eBtn) {
      eBtn.addEventListener("click", function () {
        runScript("intentional-error", "(function(){ throw new Error('cep-extension scaffold error probe'); })()");
      });
    }
    var clearBtn = document.getElementById("btn-clear");
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        document.getElementById("result").textContent = "(cleared)";
      });
    }
    log("info", "panel wired");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", wire);
  } else {
    wire();
  }
})();
