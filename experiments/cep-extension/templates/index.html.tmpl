<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{EXT_TITLE:html}}</title>

  <!--
    Panel CSP. Generated scaffold default; tighten before any real use.
    'unsafe-eval' is kept because CSInterface.js/CEPEngine internals may
    require it on CEP 12 — this is UNVERIFIED (see LOAD-PROOF.md).
    Status: scaffold output, never loaded by a real AE.
  -->
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline';" />

  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0.5em; }
    h1   { font-size: 1.1em; margin: 0 0 0.5em 0; }
    .row { display: flex; gap: 0.5em; margin-bottom: 0.25em; align-items: center; }
    pre  { background: #f4f4f4; padding: 0.5em; font-size: 12px; overflow: auto; max-height: 12em; }
    .meta { font-size: 11px; color: #555; }
  </style>
</head>
<body>
  <h1>{{EXT_TITLE:html}}</h1>
  <div class="meta" id="panel-meta">extension: {{EXT_ID}} v{{EXT_VERSION}}</div>

  <div class="row">
    <button id="btn-api-version">getCurrentApiVersion()</button>
    <span id="api-version" class="meta">(not yet queried)</span>
  </div>

  <div class="row">
    <button id="btn-ae-version">Read app.version</button>
    <button id="btn-ae-error">Run intentional error probe</button>
    <button id="btn-clear">Clear</button>
  </div>

  <h2>Result</h2>
  <pre id="result">(none)</pre>

  <!--
    CSInterface.js is BUNDLED with the extension (copied verbatim from
    Adobe-CEP/CEP-Resources CEP_12.x by scaffold.mjs) — the official
    cookbook requires including it in the extension; the host does not
    provide it. Order matters: CSInterface -> wrapper -> main.js.
  -->
  <script src="CSInterface.js"></script>
  <script src="js/csinterface-wrapper.js"></script>
  <script src="js/main.js"></script>
</body>
</html>
