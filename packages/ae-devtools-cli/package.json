{
  "name": "@ido-bata/ae-devtools-cli",
  "version": "0.5.0",
  "description": "Developer CLI, JSX/TypeScript toolchain, MCP server and extension devkits for After Effects scripting/extension/native development",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ido-bata/ae-devtools.git",
    "directory": "packages/ae-devtools-cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "bin": {
    "ae-devtools": "./devtools-cli/cli.mjs",
    "jsx-toolchain": "./jsx-toolchain/src/cli.mjs",
    "ae-devtools-mcp": "./mcp-server/server.mjs",
    "ae-devtools-recover": "./recovery-orchestrator/cli.mjs",
    "ae-devtools-cep": "./cep-extension/devkit.mjs",
    "ae-devtools-cep-lifecycle": "./cep-extension/cep-lifecycle.mjs",
    "ae-devtools-debug": "./vscode-debugger/src/cli.mjs"
  },
  "exports": {
    "./agent-loop": "./agent-loop/loop.mjs",
    "./agent-loop/fake-host": "./agent-loop/fake-host.mjs",
    "./trusted-execution/runner.mjs": "./trusted-execution/runner.mjs",
    "./trusted-execution/permissions.mjs": "./trusted-execution/permissions.mjs"
  },
  "files": [
    "devtools-cli",
    "dev-loop",
    "trusted-execution",
    "scripting-adapters",
    "a8n-transport",
    "mcp-server",
    "recovery-orchestrator",
    "diagnostics",
    "cep-extension",
    "agent-loop",
    "vscode-extension",
    "vscode-debugger",
    "jsx-toolchain/src",
    "jsx-toolchain/fixtures",
    "README.md",
    "scripts/test-harness.mjs",
    "scripts/testkit.mjs",
    "scripts/check-syntax.mjs",
    "jsx-toolchain/real-run.mjs",
    "conformance"
  ],
  "scripts": {
    "test": "node scripts/check-syntax.mjs && node devtools-cli/tests/run.mjs && node dev-loop/tests/run.mjs && node trusted-execution/tests/run.mjs && node scripting-adapters/tests/run.mjs && node a8n-transport/tests/run.mjs && node mcp-server/tests/run.mjs && node recovery-orchestrator/tests/run.mjs && node diagnostics/tests/run.mjs && node jsx-toolchain/tests/run.mjs && node cep-extension/tests/run.mjs && node agent-loop/tests/run.mjs && node vscode-extension/tests/run.mjs && node vscode-debugger/tests/run.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "@ido-bata/ae-a8n": "0.2.0",
    "acorn": "^8.19.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "jsonc-parser": "^3.3.1"
  }
}
